# Copy the names you need into .env (Vercel) or your n8n instance variables.
# No values live in this file. Keys are read server-side only.

# Vercel API — api/qualify.js
GEMINI_API_KEY=
# Enables live scoring with Gemini 2.0 Flash. Leave unset and the API runs in demo mode (rule engine, no key needed).

# n8n workflow — n8n/ai-lead-qualifier.n8n.json
OPENAI_API_KEY=
# Key for the LLM scoring HTTP Request node in n8n.
LLM_BASE_URL=
# OpenAI-compatible base URL for the n8n scoring call. Defaults in the workflow to https://api.openai.com/v1 when unset.
LLM_MODEL=
# Model name for the n8n scoring call. Defaults in the workflow to gpt-4o-mini when unset.
SUPABASE_URL=
# Project URL for the Supabase insert in n8n, e.g. the https://<project>.supabase.co form.
SUPABASE_SERVICE_ROLE_KEY=
# Service-role key for the server-side insert into public.leads in n8n. Never expose this in the browser.
SLACK_WEBHOOK_URL=
# Incoming webhook URL for the #sales-hot / #sales-warm alerts in n8n.
